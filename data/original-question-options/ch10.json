      "distractors": [
        {
          "text": "4倍",
          "reason": "黒体放射出力は絶対温度の二乗ではなく四乗に比例します。"
        },
        {
          "text": "2倍",
          "reason": "温度の一次でなく四乗です。"
        },
        {
          "text": "1/16倍",
          "reason": "温度を増やす場合は四乗で増加し、逆数にはなりません。"
        }
      ]
    },
    {
      "sectionId": "10.2",
      "distractors": [
        {
          "text": "0.7",
          "reason": "吸収率0.7を反射率へそのまま使った。吸収と反射は異なる行き先。"
        },
        {
          "text": "1.0",
          "reason": "全入射が反射する値であり、吸収率0.7と両立しない。"
        },
        {
          "text": "0.0",
          "reason": "反射なしなら不透明面の吸収率は1となり、与条件と違う。"
        }
      ]
    },
    {
      "sectionId": "10.3",
      "distractors": [
        {
          "text": "F₁₂=F₂₁",
          "reason": "形態係数は面積の異なる面では等しいとは限りません。"
        },
        {
          "text": "F₁₂+F₂₁=1",
          "reason": "相反則は単純な和ではありません。"
        },
        {
          "text": "A₁+A₂=F₁₂+F₂₁",
          "reason": "両辺の単位が一致せず物理的に不正です。"
        }
      ]
    },
    {
      "sectionId": "10.4",
      "distractors": [
        {
          "text": "800 W/m²",
          "reason": "これは放射発散度であり、正味は入射Gを引きます。"
        },
        {
          "text": "1400 W/m²",
          "reason": "放射発散度と入射を足すと符号を誤ります。"
        },
        {
          "text": "−200 W/m²",
          "reason": "ここでは面から出る方向を正としてJ−Gを計算します。"
        }
      ]
    },
    {
      "sectionId": "10.5",
      "distractors": [
        {
          "text": "増加する",
          "reason": "吸収媒体では光路が長いほど減衰しやすくなります。"
        },
        {
          "text": "変わらない",
          "reason": "Beer–Lambert型の透過率はLに依存します。"
        },
        {
          "text": "必ず1になる",
          "reason": "光路を伸ばしても透明になるわけではありません。"
        }
      ]
    },
    {
      "sectionId": "10.6",
      "distractors": [
        {
          "text": "同じ値になる。可視で黒い面は熱赤外でも黒",
          "reason": "吸収率と放射率は波長領域と測定条件に依存します。"
        },
        {
          "text": "同じ値になる。Kirchhoffの法則は全波長無条件で成立",
          "reason": "法則は同波長・方向などの熱平衡条件に基づきます。"
        },
        {
          "text": "同じ値になる。いずれも温度の単位K",
          "reason": "両者は無次元光学係数であり温度単位ではありません。"
        }
      ]
    }
  ]
